@inherits LayoutComponentBase
@using Clayzor.Lib.Web.Controls.Themes

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
        <MudText Typo="Typo.h6">Пользователи</MudText>
    </MudAppBar>
    <MudMainContent Class="pa-6">
        <ClayErrorBar />
        <ClayDbReconnectOverlay />
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = ClayTheme.Create();
}
