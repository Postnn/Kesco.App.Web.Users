@page "/user"
@using Clayzor.Lib.DALC
@using Clayzor.Lib.Entities.Inventory
@inject DbManager Db

<PageTitle>Сотрудник</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Сотрудник</MudText>

@if (!_loading && _employee is null)
{
    <MudAlert Severity="Severity.Warning">Сотрудник с указанным идентификатором не найден.</MudAlert>
}
else if (_employee is not null)
{
    <MudPaper Class="pa-4" MaxWidth="600px">
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Идентификатор" Value="@_employee.Id.ToString()"
                          ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Сотрудник" Value="@_employee.Name"
                          ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Имя на английском" Value="@_employee.NameEn"
                          ReadOnly="true" Variant="Variant.Outlined" />
        </MudStack>
    </MudPaper>
}

<MudOverlay Visible="@_loading" DarkBackground="true">
    <div class="clay-busy">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span>Загрузка сотрудника…</span>
    </div>
</MudOverlay>

@code {
    private Employee? _employee;
    private bool _loading = true;

    /// <summary>Идентификатор сотрудника из параметра запроса id.</summary>
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    /// <summary>Загружает сотрудника один раз после интерактивного рендера страницы.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RunBusyAsync(LoadEmployeeAsync);
    }

    private async Task LoadEmployeeAsync()
    {
        if (Id <= 0)
            return;

        _employee = (await Db.QueryAsync<Employee>(
            SQLQueries.SELECT_СотрудникПоИдентификатору,
            new { Id })).SingleOrDefault();
    }

    private async Task RunBusyAsync(Func<Task> work)
    {
        _loading = true;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await work();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
